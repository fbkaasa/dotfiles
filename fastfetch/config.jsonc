{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/images/fbk.txt",
    "color": {
      "1": "#C4A7E7"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#C4A7E7"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "CachyOS (btw)"
    },
    {
      "type": "host",
      "key": "🖥 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "FBK"
    },
    {
      "type": "shell",
      "format": "{}",
      "key": ">_",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "AMD Ryzen 7 9600X",
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "AMD Radeon RX 9070 XT"
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4",
      "format": "{} / {}"
    },
    
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#c4a7e7",
      "color": "#e0def4"
    },
    
    "break",
    "break",
    "break"
  ]
}
